<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Text Diff Checker - Compare and Find Differences | IT Tools</title>
    <meta name="description" content="Compare two texts and find differences instantly. Highlight changes between documents, code, or any text content.">
    <meta name="keywords" content="text diff, diff checker, compare text, find differences, text comparison">
    
    <!-- CSS -->
    <link rel="stylesheet" href="https://it-tools.roptive.com/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

    <script src="https://it-tools.roptive.com/js/header.js"></script>
    
    <style>
        /* Main container styling */
        body {
            background-color: #f9fafb;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .tool-container {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            padding: 30px 20px;
            flex: 1;
        }
        
        /* Header styling */
        .tool-header {
            text-align: center;
            margin-bottom: 30px;
            padding: 0 20px;
        }
        
        .tool-header h1 {
            font-size: 2.2rem;
            color: #111827;
            margin-bottom: 10px;
        }
        
        .tool-header p {
            color: #6b7280;
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto;
        }
        
        /* Input section */
        .input-group {
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            padding: 20px;
            margin-bottom: 20px;
            width: 100%;
        }
        
        .input-group h3 {
            margin-top: 0;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 10px;
            font-size: 1.1rem;
        }
        
        #text-input-1, #text-input-2, #diff-output {
            width: 100%;
            min-height: 200px;
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            font-family: 'Fira Code', monospace;
            resize: vertical;
        }
        
        #text-input-1:focus, #text-input-2:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        /* Diff output styling */
        #diff-output {
            background-color: #f8fafc;
            white-space: pre-wrap;
            line-height: 1.5;
        }
        
        .diff-added {
            background-color: #d1fae5;
            color: #065f46;
        }
        
        .diff-removed {
            background-color: #fee2e2;
            color: #b91c1c;
            text-decoration: line-through;
        }
        
        /* Two-column layout */
        .diff-columns {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }
        
        .diff-column {
            flex: 1;
        }
        
        /* Action buttons */
        .action-buttons-row {
            display: flex;
            gap: 10px;
            margin: 15px 0;
            flex-wrap: wrap;
        }
        
        .tool-button {
            padding: 12px 20px;
            background: #3b82f6;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: all 0.2s ease;
            font-weight: 500;
            white-space: nowrap;
        }
        
        .tool-button:hover {
            background: #2563eb;
            transform: translateY(-1px);
        }
        
        .tool-button:disabled {
            background: #9ca3af;
            cursor: not-allowed;
            transform: none;
        }
        
        .tool-button.secondary {
            background: #f3f4f6;
            color: #111827;
        }
        
        .tool-button.secondary:hover {
            background: #e5e7eb;
        }
        
        /* Status message */
        .status-message {
            margin: 15px 0;
            padding: 10px;
            border-radius: 6px;
            display: none;
            width: 100%;
        }
        
        .status-message.success {
            background: #d1fae5;
            color: #065f46;
            display: block;
        }
        
        .status-message.error {
            background: #fee2e2;
            color: #b91c1c;
            display: block;
        }
        
        /* Instructions */
        .instructions {
            background-color: #f8fafc;
            border-left: 4px solid #3b82f6;
            padding: 15px;
            margin: 20px 0;
            border-radius: 0 8px 8px 0;
            width: 100%;
        }
        
        .instructions h3 {
            margin-top: 0;
            color: #1e293b;
            font-size: 1.1rem;
        }
        
        .instructions ul {
            padding-left: 20px;
            margin-bottom: 0;
        }
        
        .instructions li {
            margin-bottom: 8px;
            color: #475569;
        }
        
        /* Privacy note */
        .privacy-note {
            text-align: center;
            color: #6b7280;
            font-size: 0.85rem;
            margin-top: 20px;
            font-style: italic;
            width: 100%;
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .tool-header h1 {
                font-size: 1.8rem;
            }
            
            .diff-columns {
                flex-direction: column;
            }
            
            .action-buttons-row {
                flex-direction: column;
            }
            
            .tool-button {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div id="headerContainer"></div>
    </header>

    <!-- Tool Content -->
    <main class="tool-container">
        <div class="tool-header">
            <h1>Text Diff Checker</h1>
            <p>Compare two texts and find differences with highlighted changes</p>
        </div>
        
        <div class="tool-content">
            <div class="diff-columns">
                <div class="diff-column">
                    <div class="input-group">
                        <h3>Original Text</h3>
                        <textarea id="text-input-1" placeholder="Enter your original text here...">The quick brown fox jumps over the lazy dog.
This is the first version of the text.
It contains some sample content for comparison.</textarea>
                    </div>
                </div>
                <div class="diff-column">
                    <div class="input-group">
                        <h3>Modified Text</h3>
                        <textarea id="text-input-2" placeholder="Enter your modified text here...">The quick brown fox leaps over the lazy dog.
This is the second version of the text.
It contains modified content for comparison.
Added a new line here.</textarea>
                    </div>
                </div>
            </div>
            
            <div class="action-buttons-row">
                <button id="compare-btn" class="tool-button">
                    <span id="compare-btn-text">Compare Texts</span>
                    <span id="compare-btn-loader" class="loading" style="display: none;"></span>
                </button>
                <button id="clear-btn" class="tool-button secondary">
                    <i class="fas fa-trash-alt"></i> Clear All
                </button>
                <button id="swap-btn" class="tool-button secondary">
                    <i class="fas fa-exchange-alt"></i> Swap Texts
                </button>
            </div>
            
            <div id="statusMessage" class="status-message"></div>
            
            <div class="input-group">
                <h3>Differences Highlighted</h3>
                <div id="diff-output" readonly>Differences will be shown here...</div>
            </div>
            
            <div class="instructions">
                <h3>How to use this Diff Checker:</h3>
                <ul>
                    <li>Enter your original text in the left box</li>
                    <li>Enter your modified text in the right box</li>
                    <li>Click <strong>Compare Texts</strong> to find differences</li>
                    <li>View highlighted changes in the output section</li>
                    <li>Use <strong>Swap Texts</strong> to exchange the inputs</li>
                </ul>
            </div>
            
            <div class="instructions">
                <h3>About Text Comparison:</h3>
                <ul>
                    <li><strong>Added text</strong>: <span class="diff-added">Highlighted in green</span></li>
                    <li><strong>Removed text</strong>: <span class="diff-removed">Highlighted in red with strikethrough</span></li>
                    <li><strong>Line-by-line comparison</strong>: Differences are shown per line</li>
                    <li><strong>Real-time updates</strong>: Automatically compares as you type (or click the button)</li>
                    <li><strong>All text formats</strong>: Works with plain text, code, JSON, etc.</li>
                </ul>
            </div>
            
            <p class="privacy-note">All processing is done in your browser - your text never leaves your computer</p>
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <div id="footerContainer"></div>
    </footer>

    <!-- JavaScript -->
    <script src="https://it-tools.roptive.com/js/script.js"></script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-61PG9HQVB4"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-61PG9HQVB4');
    </script>
     
    <script>
        // DOM elements
        const textInput1 = document.getElementById('text-input-1');
        const textInput2 = document.getElementById('text-input-2');
        const diffOutput = document.getElementById('diff-output');
        const compareBtn = document.getElementById('compare-btn');
        const compareBtnText = document.getElementById('compare-btn-text');
        const compareBtnLoader = document.getElementById('compare-btn-loader');
        const clearBtn = document.getElementById('clear-btn');
        const swapBtn = document.getElementById('swap-btn');
        const statusMessage = document.getElementById('statusMessage');
        
        // Event listeners
        compareBtn.addEventListener('click', compareTexts);
        clearBtn.addEventListener('click', clearAll);
        swapBtn.addEventListener('click', swapTexts);
        textInput1.addEventListener('input', compareTexts);
        textInput2.addEventListener('input', compareTexts);
        
        // Initial comparison
        compareTexts();
        
        function compareTexts() {
            const text1 = textInput1.value;
            const text2 = textInput2.value;
            
            // Show loading state
            compareBtn.disabled = true;
            compareBtnText.style.display = 'none';
            compareBtnLoader.style.display = 'inline-block';
            
            // Use setTimeout to allow UI to update before processing
            setTimeout(() => {
                try {
                    // Split texts into lines
                    const lines1 = text1.split('\n');
                    const lines2 = text2.split('\n');
                    
                    // Initialize variables for comparison
                    let output = '';
                    let i = 0, j = 0;
                    
                    // Compare line by line
                    while (i < lines1.length || j < lines2.length) {
                        if (i < lines1.length && j < lines2.length && lines1[i] === lines2[j]) {
                            // Lines are identical
                            output += escapeHtml(lines1[i]) + '\n';
                            i++;
                            j++;
                        } else {
                            // Lines are different - find added/removed lines
                            if (j < lines2.length && (i >= lines1.length || lines1[i] !== lines2[j])) {
                                // Added line
                                output += `<span class="diff-added">${escapeHtml(lines2[j])}</span>\n`;
                                j++;
                            }
                            if (i < lines1.length && (j >= lines2.length || lines1[i] !== lines2[j])) {
                                // Removed line
                                output += `<span class="diff-removed">${escapeHtml(lines1[i])}</span>\n`;
                                i++;
                            }
                        }
                    }
                    
                    // Update output
                    diffOutput.innerHTML = output;
                    
                    showStatus('Texts compared successfully!', 'success');
                    
                } catch (error) {
                    showStatus('Error comparing texts: ' + error.message, 'error');
                    console.error('Error comparing texts:', error);
                } finally {
                    compareBtn.disabled = false;
                    compareBtnText.style.display = 'inline-block';
                    compareBtnLoader.style.display = 'none';
                }
            }, 100);
        }
        
        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
        
        function swapTexts() {
            const temp = textInput1.value;
            textInput1.value = textInput2.value;
            textInput2.value = temp;
            compareTexts();
            showStatus('Texts swapped!', 'success');
        }
        
        function clearAll() {
            textInput1.value = '';
            textInput2.value = '';
            diffOutput.innerHTML = 'Differences will be shown here...';
            showStatus('Cleared all text!', 'success');
        }
        
        function showStatus(message, type) {
            statusMessage.textContent = message;
            statusMessage.className = 'status-message ' + type;
            
            // Hide message after 5 seconds
            setTimeout(() => {
                statusMessage.textContent = '';
                statusMessage.className = 'status-message';
            }, 5000);
        }
    </script>
</body>
</html>